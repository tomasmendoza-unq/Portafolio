---
import CardProject from "../card/CardProject.astro";
import { projects } from "./projects";


---

<section id="projects">
    <h2 class="title-section">Proyectos destacados</h2>
    <div class="projects-section">
        {projects.map((project) => (
            <CardProject {...project} />
        ))}
    </div>
</section>

<style>
    #projects {
        scroll-snap-align: start;
        background: var(--color-project);
        padding: 5rem 2rem;
    }
    .projects-section {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 2rem;
    }
    .title-section {
        font-size: 3rem;
        color: white;
        text-align: center;
        margin-bottom: 2rem;
    }
</style>